 {
  "test": "ID_LongestMatch",
  "cases": [
   {
    "robots": "user-agent: FooBot\ndisallow: /x/page.html\nallow: /x/\n",
    "agent": "FooBot",
    "url": "http://foo.bar/x/page.html",
    "expected": false
   },
   {
    "robots": "user-agent: FooBot\nallow: /x/page.html\ndisallow: /x/\n",
    "agent": "FooBot",
    "url": "http://foo.bar/x/page.html",
    "expected": true
   },
   {
    "robots": "user-agent: FooBot\nallow: /x/page.html\ndisallow: /x/\n",
    "agent": "FooBot",
    "url": "http://foo.bar/x/",
    "expected": false
   },
   {
    "robots": "user-agent: FooBot\ndisallow: \nallow: \n",
    "agent": "FooBot",
    "url": "http://foo.bar/x/page.html",
    "expected": true
   },
   {
    "robots": "user-agent: FooBot\ndisallow: /\nallow: /\n",
    "agent": "FooBot",
    "url": "http://foo.bar/x/page.html",
    "expected": true
   },
   {
    "robots": "user-agent: FooBot\ndisallow: /x\nallow: /x/\n",
    "agent": "FooBot",
    "url": "http://foo.bar/x",
    "expected": false
   },
   {
    "robots": "user-agent: FooBot\ndisallow: /x\nallow: /x/\n",
    "agent": "FooBot",
    "url": "http://foo.bar/x/",
    "expected": true
   },
   {
    "robots": "user-agent: FooBot\ndisallow: /x/page.html\nallow: /x/page.html\n",
    "agent": "FooBot",
    "url": "http://foo.bar/x/page.html",
    "expected": true
   },
   {
    "robots": "user-agent: FooBot\nallow: /page\ndisallow: /*.html\n",
    "agent": "FooBot",
    "url": "http://foo.bar/page.html",
    "expected": false
   },
   {
    "robots": "user-agent: FooBot\nallow: /page\ndisallow: /*.html\n",
    "agent": "FooBot",
    "url": "http://foo.bar/page",
    "expected": true
   },
   {
    "robots": "user-agent: FooBot\nallow: /x/page.\ndisallow: /*.html\n",
    "agent": "FooBot",
    "url": "http://foo.bar/x/page.html",
    "expected": true
   },
   {
    "robots": "user-agent: FooBot\nallow: /x/page.\ndisallow: /*.html\n",
    "agent": "FooBot",
    "url": "http://foo.bar/x/y.html",
    "expected": false
   },
   {
    "robots": "User-agent: *\nDisallow: /x/\nUser-agent: FooBot\nDisallow: /y/\n",
    "agent": "FooBot",
    "url": "http://foo.bar/x/page",
    "expected": true
   },
   {
    "robots": "User-agent: *\nDisallow: /x/\nUser-agent: FooBot\nDisallow: /y/\n",
    "agent": "FooBot",
    "url": "http://foo.bar/y/page",
    "expected": false
   }
  ],
  "asserts_total": 14
 },
